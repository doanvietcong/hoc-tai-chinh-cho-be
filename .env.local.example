# TTS Provider Configuration
# Script tự động detect provider có key. Ưu tiên: ElevenLabs > Vbee > FPT.AI

# ============================================
# ElevenLabs V3 (RECOMMENDED) - giọng AI tự nhiên nhất + audio tags
# ============================================
# Free: 10,000 chars/tháng (V3 tính gấp đôi = ~5K chars thực tế cho project này)
# Đăng ký: https://elevenlabs.io → Settings → API Keys
ELEVENLABS_API_KEY=

# Model ID (để trống = mặc định V3 - khuyến nghị)
#   eleven_v3          - V3 chuẩn, expressive nhất, hỗ trợ audio tags (RECOMMENDED)
#   eleven_turbo_v3    - V3 nhanh, ít expressive
#   eleven_multilingual_v2 - V2 fallback (kém tự nhiên hơn V3)
ELEVENLABS_MODEL_ID=

# Voice ID (để trống = mặc định "Adam" nam trầm kể chuyện)
# Gợi ý giọng tiếng Việt (V3 hỗ trợ tốt):
#   pNInz6obpgDQGcFmaJgB - Adam    (nam, trầm, kể chuyện tốt) ← MẶC ĐỊNH
#   21m00Tcm4TlvDq8ikWAM - Rachel  (nữ, dịu dàng, ấm áp)
#   AZnzlk1XvdvUeBnXmlld - Domi    (nữ, trẻ trung, vui tươi)
#   EXAVITQu4vr4xnSDxMaL - Bella   (nữ, mềm mại, dễ thương)
#   2EiwWnXFnvU5JinP4o6y - Sam     (nam, kể chuyện adventure)
#   gU0LNdkMOjJABWrEB4h3 - Charlie (nam, năng động)
#   LcfcDJNUP1GQjkzn1xUU - Emily   (nữ, mature)
# Tìm thêm: https://elevenlabs.io/voice-library
ELEVENLABS_VOICE_ID=

# ============================================
# Vbee (giọng Việt native - backup)
# ============================================
# (Chỉ cần nếu KHÔNG dùng ElevenLabs. Free: ~100K chars/tháng)
# VBEE_API_KEY=
# VBEE_VOICE_CODE=hn_female_ngochuyen_full_48k-fhg

# ============================================
# FPT.AI (giọng Việt chuẩn - backup 2)
# ============================================
# (Chỉ cần nếu KHÔNG dùng ElevenLabs/Vbee. Free: 20K chars/tháng)
# FPT_AI_API_KEY=
# FPT_AI_VOICE=lemy

# ============================================
# Tùy chọn: ép dùng provider (mặc định auto-detect)
# ============================================
# TTS_PROVIDER=elevenlabs
# TTS_PROVIDER=vbee
# TTS_PROVIDER=fpt
